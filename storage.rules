rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Documents: authenticated users can upload, must be PDF or image (no SVG), max 10MB
    match /documents/{entityType}/{entityId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('application/pdf|image/(jpeg|png|webp|heic)');
    }

    // Templates: only Cloud Functions write here (admin SDK bypasses rules)
    match /templates/{fileName} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Signed documents (Yousign): Cloud Functions only, admin reads via signed URLs
    match /signed/{fileName} {
      allow read: if false; // Only accessible via signed URLs from Cloud Functions
      allow write: if false;
    }
  }
}
