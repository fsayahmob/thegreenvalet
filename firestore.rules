rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ──────────────────────────────────────

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    function isAuth() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    // Check if user owns the entity referenced in a document
    function ownsEntity(entityType, entityId) {
      return isAuth() && (
        (entityType == "partner"
          && exists(/databases/$(database)/documents/partners/$(entityId))
          && get(/databases/$(database)/documents/partners/$(entityId)).data.userId == request.auth.uid)
        ||
        (entityType == "operator"
          && exists(/databases/$(database)/documents/operators/$(entityId))
          && get(/databases/$(database)/documents/operators/$(entityId)).data.userId == request.auth.uid)
      );
    }

    // ─── Users ────────────────────────────────────────

    match /users/{uid} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // Enum validators
    function isValidLeadStatus(s) {
      return s in ["new", "contacted", "qualified", "converted", "rejected"];
    }
    function isValidPartnerStatus(s) {
      return s in ["prospect", "onboarding", "active", "suspended"];
    }
    function isValidOperatorStatus(s) {
      return s in ["prospect", "onboarding", "active", "suspended"];
    }
    function isValidDocStatus(s) {
      return s in ["uploaded", "approved", "rejected", "expired"];
    }

    // ─── Leads ────────────────────────────────────────
    // Cloud Functions write with admin SDK (bypasses rules)
    // Only admin can read/write from client

    match /leads/{leadId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && isValidLeadStatus(request.resource.data.status);
      allow update: if isAdmin()
        && isValidLeadStatus(request.resource.data.status);
      allow delete: if false;
    }

    // ─── Partners ─────────────────────────────────────

    match /partners/{partnerId} {
      allow read: if isAdmin()
        || (isAuth() && resource.data.userId == request.auth.uid);
      allow create: if isAdmin()
        && isValidPartnerStatus(request.resource.data.status);
      allow update: if isAdmin()
        && isValidPartnerStatus(request.resource.data.status);
      allow delete: if false; // Never delete — soft delete via status

      match /communications/{commId} {
        allow read, write: if isAdmin();
      }
    }

    // ─── Operators ────────────────────────────────────

    match /operators/{operatorId} {
      allow read: if isAdmin()
        || (isAuth() && resource.data.userId == request.auth.uid);
      allow create: if isAdmin()
        && isValidOperatorStatus(request.resource.data.status);
      allow update: if isAdmin()
        && isValidOperatorStatus(request.resource.data.status);
      allow delete: if false;

      match /communications/{commId} {
        allow read, write: if isAdmin();
      }
    }

    // ─── Sites ────────────────────────────────────────

    match /sites/{siteId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // ─── Documents ────────────────────────────────────
    // Admin: full access
    // Entity owners: read own docs, create new uploads

    match /documents/{docId} {
      allow read: if isAdmin()
        || ownsEntity(resource.data.entityType, resource.data.entityId);
      allow create: if isAdmin()
        || (isAuth()
          && request.resource.data.keys().hasAll(['entityType', 'entityId', 'type', 'fileName', 'status'])
          && request.resource.data.status == 'uploaded'
          && isValidDocStatus(request.resource.data.status)
          && ownsEntity(request.resource.data.entityType, request.resource.data.entityId));
      allow update: if isAdmin()
        && isValidDocStatus(request.resource.data.status);
      allow delete: if isAdmin();
    }

    // ─── Templates ────────────────────────────────────

    match /templates/{templateId} {
      allow read: if isAdmin() || (isAuth() && resource.data.isPublic == true);
      allow write: if isAdmin();
    }

    // ─── Yousign ──────────────────────────────────────

    match /yousign_requests/{requestId} {
      allow read, write: if isAdmin();
    }
  }
}
